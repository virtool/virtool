{
	// Every module here runs in a workflow executor, which is a plain Node
	// process. There is no browser half to keep `node:*` out of, so unlike
	// `@virtool/contracts` this package typechecks as one project.
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"types": ["node"],
		// On here, though `packages/tsconfig.base.json` leaves it off. Every app
		// turns it on, and an app bundles this package from source — so a lookup
		// this project let through is an error in the app that imports it, at a
		// path that names a file nobody editing that app is looking at. Checking
		// it here is what keeps the four workflow executors from each rediscovering
		// the same twenty errors.
		"noUncheckedIndexedAccess": true
	},
	"include": ["src"]
}
