{
	// The node half of the package. `src/browser.ts` is the one module a React
	// component imports, and it is checked separately by `tsconfig.browser.json`
	// with no Node types, so a Node global cannot reach the client bundle
	// unremarked. Add a module here as you add its subpath export.
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"types": ["node"]
	},
	"include": ["src/index.ts", "src/log.ts", "src/log.test.ts"]
}
