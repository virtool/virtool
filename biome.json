{
	"$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!packages/pathoscope-core",
			"!apps/site/**",
			"!**/routeTree.gen.ts",
			"!**/node_modules",
			"!**/dist",
			"!**/dist-types",
			"!**/.output",
			"!**/.nitro",
			"!**/.tanstack"
		]
	},
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"nursery": {
				"useReactFunctionComponentDefinition": "error"
			},
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"@tanstack/react-router": {
								"importNames": ["useMatchRoute"],
								"message": "useMatchRoute breaks React Compiler reactivity (TanStack Router #4499). Use useMatchPartialPath from @app/useMatchPartialPath instead."
							}
						}
					}
				},
				"useConsistentTypeDefinitions": {
					"level": "error",
					"options": {
						"style": "type"
					}
				},
				"useLiteralEnumMembers": "error"
			},
			"suspicious": {
				"noConsole": "error",
				"noImplicitAnyLet": "error",
				"noExplicitAny": "error",
				"noArrayIndexKey": "error",
				"useIterableCallbackReturn": "error",
				"noShadowRestrictedNames": "error",
				"noGlobalAssign": "error"
			},
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedFunctionParameters": "error",
				"noInvalidPositionAtImportRule": "error"
			},
			"security": {
				"noDangerouslySetInnerHtml": "error"
			},
			"a11y": {
				"noLabelWithoutControl": "error",
				"noSvgWithoutTitle": "error",
				"noStaticElementInteractions": "error",
				"useValidAnchor": "error",
				"useKeyWithClickEvents": "error",
				"useHtmlLang": "error"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["apps/web/src/**", "!apps/web/src/server/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@virtool/data/**", "@virtool/storage", "@virtool/storage/**"],
										"message": "@virtool/data and @virtool/storage are server-only: they open Postgres and object storage, and reach node:* APIs the browser has none of. Reach them through src/server/**, which the client transform strips."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["apps/web/src/server/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/**",
											"@account/**",
											"@administration/**",
											"@analyses/**",
											"@app/**",
											"@banner/**",
											"@base/**",
											"@dashboard/**",
											"@forms/**",
											"@groups/**",
											"@hmm/**",
											"@indexes/**",
											"@jobs/**",
											"@labels/**",
											"@nav/**",
											"@otus/**",
											"@quality/**",
											"@references/**",
											"@samples/**",
											"@sequences/**",
											"@subtraction/**",
											"@tasks/**",
											"@tests/**",
											"@uploads/**",
											"@users/**",
											"@wall/**"
										],
										"message": "src/server must not import from browser feature modules. The dependency arrow runs client -> @server/*; shared types and helpers belong in @virtool/contracts, which both sides import down into. Every feature alias is listed, plus the @/* catch-all that would otherwise reach the same modules by another name."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["apps/*/src/**", "!apps/web/src/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/**",
											"@account/**",
											"@administration/**",
											"@analyses/**",
											"@app/**",
											"@banner/**",
											"@base/**",
											"@dashboard/**",
											"@forms/**",
											"@groups/**",
											"@hmm/**",
											"@indexes/**",
											"@jobs/**",
											"@labels/**",
											"@nav/**",
											"@otus/**",
											"@quality/**",
											"@references/**",
											"@samples/**",
											"@sequences/**",
											"@server/**",
											"@subtraction/**",
											"@tasks/**",
											"@tests/**",
											"@uploads/**",
											"@users/**",
											"@virtool/web",
											"@wall/**",
											"**/apps/web/**",
											"**/web/src/**"
										],
										"message": "A non-Vite app must not import from apps/web, in either direction. apps/jobs-api is the likeliest offender because it does work src/server also does, so copying an import from there is an easy mistake. Shared shapes and helpers belong in @virtool/contracts, @virtool/data or @virtool/storage, which both sides import down into."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
