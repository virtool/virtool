---
import Logo from "@components/Logo.astro";
import NavLink from "@components/NavLink.astro";
import "../styles/global.css";

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link href="/prism.css" rel="stylesheet" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="overflow-y-scroll bg-[#f7fafc]">
    <nav class="sticky top-0 z-20 h-header bg-zinc-200">
      <div class="mx-auto flex h-full max-w-6xl items-center gap-6 px-6 sm:gap-11">
        <a
          class="inline-flex gap-2 font-medium items-center no-underline text-stone-600 hover:text-stone-900 fill-stone-600 hover:fill-stone-900 text-xl"
          href="/"
        >
          <Logo />
          <span class="sr-only sm:not-sr-only">Virtool</span>
        </a>

        <div class="flex items-center gap-4 sm:gap-6">
          <NavLink href="/docs">Docs</NavLink>
          <NavLink href="/blog">Blog</NavLink>
          <NavLink href="/changelog">Changelog</NavLink>
        </div>
      </div>
    </nav>
    <main class="mx-auto max-w-6xl px-6 pt-8 pb-20">
      <slot />
    </main>
  </body>
</html>
