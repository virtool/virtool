---
import Layout from "./Layout.astro";

const { title }: { title: string } = Astro.props;
---

<Layout title={title} fullWidth>
  <div class="grid grid-cols-[13rem_minmax(0,56rem)] gap-x-8 pr-6">
    <div
      class="sticky top-24 max-h-[calc(100vh-7rem)] self-start overflow-y-auto pl-12 pr-4"
      data-sidebar
    >
      <slot name="sidebar" />
    </div>
    <div class="prose max-w-none">
      <slot />
    </div>
  </div>
</Layout>
