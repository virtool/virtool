---
import Aside from "@components/Aside.astro";
import DummyButton from "@components/DummyButton.astro";
import Icon from "@components/Icon.astro";
import Key from "@components/Key.astro";
import MdxImage from "@components/MdxImage.astro";
import Note from "@components/Note.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Menu from "@components/menu/Menu.astro";
import SidebarLayout from "@layouts/SidebarLayout.astro";
import { getMenuSectionsFromCollection } from "@utils/menu";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const manualEntries = await getCollection("manual");

  return manualEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const sections = getMenuSectionsFromCollection(
  await getCollection("manual"),
  ["start", "tutorials", "guide", "api", "science"]
);

const { entry } = Astro.props;
const { Content, components, headings } = await render(entry);
---

<SidebarLayout title={entry.data.title}>
  <Menu slot="sidebar" sections={sections} baseUrl="/docs" />
  <TableOfContents slot="toc" headings={headings} />
  <h1>{entry.data.title}</h1>
  <div class="prose max-w-4xl">
    <Content
      components={{
        ...components,
        Aside: Aside,
        DummyButton: DummyButton,
        Icon: Icon,
        Key: Key,
        Note: Note,
        img: MdxImage,
      }}
    />
  </div>
</SidebarLayout>
