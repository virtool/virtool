---
import ActionRequired from "@components/ActionRequired.astro";
import Menu from "@components/menu/Menu.astro";
import Note from "@components/Note.astro";
import ReleaseNotes from "@components/ReleaseNotes.astro";
import Switch from "@components/Switch.astro";
import Layout from "@layouts/Layout.astro";
import {
  getReleaseSections,
  isMaintenanceOnly,
  parseChangelog,
  RELEASES_PER_PAGE,
} from "@utils/changelog";
import { formatDate } from "@utils/date";
import { loadPosts } from "@utils/loadPosts";
import type { GetStaticPaths } from "astro";
import changelog from "../../../../web/CHANGELOG.md?raw";

export const getStaticPaths = (({ paginate }) => {
  const releases = parseChangelog(changelog);

  return paginate(releases, {
    pageSize: RELEASES_PER_PAGE,
    props: {
      sections: getReleaseSections(releases),
    },
  });
}) satisfies GetStaticPaths;

const { page, sections } = Astro.props;
const { released } = await loadPosts();

const releases = page.data.map((release) => ({
  ...release,
  maintenanceOnly: isMaintenanceOnly(release),
  posts: released.filter(({ version }) => version === release.version),
}));
---

<Layout title="Changelog">
  <div class="flex gap-16">
    <div
      class="shrink-0 self-start sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto tabular-nums"
      data-release-menu
    >
      <Menu sections={sections} />
    </div>
    <div class="prose max-w-4xl">
      <div class="mb-8 flex items-center justify-between gap-4">
        <h1 class="mb-0">Changelog</h1>
        <label class="not-prose flex shrink-0 items-center gap-2 text-stone-600">
          <Switch id="show-maintenance" autocomplete="off" />
          Show maintenance
        </label>
      </div>
      <script is:inline>
        document.getElementById("show-maintenance").checked =
          localStorage.getItem("show-maintenance") === "true";
      </script>
      {
        releases.map(({ version, date, actions, body, maintenance, maintenanceOnly, posts }) => (
          <section
            id={version}
            class="scroll-mt-24"
            data-maintenance={maintenanceOnly || undefined}
          >
            <h2 class="mb-1">{version}</h2>
            <p class="mt-0 text-stone-600">
              <time datetime={date}>{formatDate(date)}</time>
            </p>
            <ActionRequired actions={actions} />
            {posts.map(({ slug, title }) => (
              <Note color="blue">
                <a href={`/posts/${slug}`}>Read the post: {title}</a>
              </Note>
            ))}
            <ReleaseNotes markdown={body} />
            {maintenance && (
              <div data-maintenance>
                <ReleaseNotes markdown={maintenance} />
              </div>
            )}
          </section>
        ))
      }
      {
        page.lastPage > 1 && (
          <nav class="not-prose mt-12 flex items-center justify-between text-stone-600">
            {page.url.prev ? (
              <a class="hover:text-stone-900" href={page.url.prev}>
                Newer releases
              </a>
            ) : (
              <span />
            )}
            <span>
              Page {page.currentPage} of {page.lastPage}
            </span>
            {page.url.next ? (
              <a class="hover:text-stone-900" href={page.url.next}>
                Older releases
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }
    </div>
  </div>
</Layout>

<style is:global>
  body:not(:has(#show-maintenance:checked)) {
    [data-maintenance],
    [data-release-menu] li:has(> ul):not(:has(li:not([data-maintenance]))) {
      display: none;
    }
  }
</style>

<script>
  const SCROLL_OFFSET = 100;

  const menu = document.querySelector<HTMLElement>("[data-release-menu]");
  const sections = [...document.querySelectorAll<HTMLElement>("section[id]")];
  const toggle = document.querySelector<HTMLInputElement>("#show-maintenance");

  if (menu && sections.length > 0) {
    const links = new Map(
      [...menu.querySelectorAll("a")].map((link) => [link.hash.slice(1), link]),
    );

    let pinned: { id: string; scrollY: number } | null = null;

    function revealLink(link: HTMLElement, container: HTMLElement) {
      const bottom = link.offsetTop + link.offsetHeight;

      if (
        link.offsetTop < container.scrollTop ||
        bottom > container.scrollTop + container.clientHeight
      ) {
        container.scrollTop = link.offsetTop - container.clientHeight / 2;
      }
    }

    // The line moves down the window as the page scrolls, so that releases too
    // short to reach the top of the window still become current.
    function getCurrentId() {
      if (pinned) {
        return pinned.id;
      }

      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      const progress = maxScroll > 0 ? window.scrollY / maxScroll : 0;
      const line = SCROLL_OFFSET + progress * (window.innerHeight - SCROLL_OFFSET);

      const visible = sections.filter((section) => section.checkVisibility());

      return (
        visible.findLast(
          (section) => section.getBoundingClientRect().top <= line,
        ) ?? visible[0]
      )?.id;
    }

    function updateCurrentLink() {
      const link = links.get(getCurrentId());

      if (!link || link.hasAttribute("aria-current")) {
        return;
      }

      for (const other of links.values()) {
        other.removeAttribute("aria-current");
      }

      link.setAttribute("aria-current", "location");
      revealLink(link, menu);
    }

    function pin(id: string) {
      if (sections.some((section) => section.id === id)) {
        pinned = { id, scrollY: window.scrollY };
        updateCurrentLink();
      }
    }

    updateCurrentLink();

    // A link can point to a release that the toggle hides.
    function revealLocationHash() {
      const target = sections.find(({ id }) => id === location.hash.slice(1));

      if (toggle && target && !target.checkVisibility()) {
        toggle.checked = true;
        target.scrollIntoView();
      }
    }

    function pinLocationHash() {
      revealLocationHash();
      pin(location.hash.slice(1));
    }

    toggle?.addEventListener("change", () => {
      updateCurrentLink();
      localStorage.setItem("show-maintenance", String(toggle.checked));
    });

    window.addEventListener("load", pinLocationHash);
    window.addEventListener("hashchange", pinLocationHash);

    window.addEventListener(
      "scroll",
      () => {
        if (pinned?.scrollY !== window.scrollY) {
          pinned = null;
        }

        updateCurrentLink();
      },
      { passive: true },
    );

    // The timeout lets the browser finish its jump to the anchor first.
    menu.addEventListener("click", (event) => {
      const link = (event.target as HTMLElement).closest("a");

      if (link) {
        setTimeout(() => pin(link.hash.slice(1)));
      }
    });
  }
</script>
