---
import Badge from "@components/Badge.astro";
import { GitPullRequest } from "@lucide/astro";

const { number }: { number: number } = Astro.props;
---

<span data-pagefind-ignore>
  <Badge
    class="ml-2 tabular-nums"
    href={`https://github.com/virtool/virtool/pull/${number}`}
    target="_blank"
  >
    <GitPullRequest aria-hidden="true" />
    {number}
  </Badge>
</span>
