---
import { ArrowDown } from "@lucide/astro";

type Step = { title: string; tool?: string; removed?: string };

type Props = { caption: string; steps: Step[] };

const { caption, steps } = Astro.props;
---

<figure class="not-prose my-6">
  <figcaption class="mb-3 text-sm font-medium text-stone-600">{caption}</figcaption>
  {/* Safari drops list semantics when `list-style` is `none`. */}
  <ol role="list" class="list-none">
    {
      steps.map(({ title, tool, removed }, index) => (
        <li>
          {index > 0 && (
            <div class="flex justify-center py-1 text-stone-400 sm:w-72" aria-hidden="true">
              <ArrowDown class="size-5" />
            </div>
          )}
          <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-4">
            <div class="rounded-md border border-stone-300 bg-white px-4 py-2 sm:w-72 sm:shrink-0">
              <div class="font-medium text-stone-900">{title}</div>
              {tool && <div class="text-sm text-stone-600">{tool}</div>}
            </div>
            {removed && (
              <p class="min-w-0 text-sm text-stone-600">
                <span class="font-medium">Removed:</span> {removed}
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</figure>
