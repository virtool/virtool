---
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"input">, "role" | "size" | "type"> & {
  size?: "default" | "sm";
};

const { class: className, size = "default", ...props } = Astro.props;

const sizeClass = {
  default: "h-[1.15rem] w-8 before:size-4",
  sm: "h-3.5 w-6 before:size-3",
}[size];
---

<input
  class:list={[
    "inline-flex shrink-0 cursor-pointer appearance-none items-center rounded-full border border-transparent bg-stone-300 shadow-xs transition-all outline-none before:block before:rounded-full before:bg-white before:transition-transform before:content-[''] checked:bg-stone-800 checked:before:translate-x-[calc(100%-2px)] focus-visible:ring-[3px] focus-visible:ring-stone-400/50 disabled:cursor-not-allowed disabled:opacity-50",
    sizeClass,
    className,
  ]}
  role="switch"
  type="checkbox"
  {...props}
/>
