---
type Props = {
  class?: string;
  href?: string;
  target?: "_blank";
  variant?: "secondary" | "outline";
};

const { class: className, href, target, variant = "secondary" } = Astro.props;

const Tag = href ? "a" : "span";

const variantClass = {
  secondary: "bg-stone-200 text-stone-800 [a&]:hover:bg-stone-300",
  outline: "border-stone-400 text-stone-800 [a&]:hover:bg-stone-200",
}[variant];
---

<Tag
  class:list={[
    "not-prose inline-flex w-fit shrink-0 items-center justify-center gap-1 rounded-full border border-transparent px-2 py-0.5 align-middle text-xs font-medium whitespace-nowrap transition-colors outline-none focus-visible:ring-[3px] focus-visible:ring-stone-400/50 [&>svg]:pointer-events-none [&>svg]:size-3",
    variantClass,
    className,
  ]}
  href={href}
  target={target}
>
  <slot />
</Tag>
