---
import {
  Ban,
  ChartArea,
  Check,
  CircleArrowUp,
  CircleCheck,
  CircleCheckBig,
  CircleX,
  Cloud,
  Copy,
  Download,
  Filter,
  History,
  Key,
  Pencil,
  Play,
  Plug,
  Redo2,
  Save,
  SquarePen,
  SquarePlus,
  Trash2,
  UserPlus,
  Users,
  Wand2,
  Wrench,
} from "@lucide/astro";

const iconMap = {
  key: Key,
  save: Save,
  "arrow-alt-circle-up": CircleArrowUp,
  download: Download,
  "check-circle": CircleCheckBig,
  "circle-check": CircleCheck,
  "times-circle": CircleX,
  "plus-square": SquarePlus,
  play: Play,
  trash: Trash2,
  filter: Filter,
  cloud: Cloud,
  history: History,
  check: Check,
  wrench: Wrench,
  ban: Ban,
  clone: Copy,
  "pencil-alt": Pencil,
  edit: SquarePen,
  "user-plus": UserPlus,
  users: Users,
  plug: Plug,
  redo: Redo2,
  "chart-area": ChartArea,
  magic: Wand2,
};

const colorMap = {
  black: "",
  blue: "text-blue-600",
  green: "text-green-600",
  orange: "text-orange-400",
  red: "text-red-600",
};

const { color = "black", name } = Astro.props;

const colorClass = colorMap[color];
const IconComponent = iconMap[name];
---

<IconComponent size={16} class={`inline align-text-bottom ${colorClass}`} />
