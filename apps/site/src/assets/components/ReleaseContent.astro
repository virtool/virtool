---
import ActionRequired from "@components/ActionRequired.astro";
import Note from "@components/Note.astro";
import ReleaseNotes from "@components/ReleaseNotes.astro";
import type { Release } from "@virtool/changelog";
import { formatDate } from "@utils/date";

type Props = {
  release: Release;
  posts: { slug: string; title: string }[];
  alwaysShowMaintenance?: boolean;
};

const { release, posts, alwaysShowMaintenance = false } = Astro.props;
const { date, actions, body, maintenance } = release;
---

<p class="mt-0 text-stone-600">
  <time datetime={date}>{formatDate(date)}</time>
</p>
<ActionRequired actions={actions} />
{
  posts.map(({ slug, title }) => (
    <Note color="blue">
      <a href={`/blog/${slug}`}>Read the post: {title}</a>
    </Note>
  ))
}
<ReleaseNotes markdown={body} />
{
  maintenance && (
    <div data-maintenance={!alwaysShowMaintenance || undefined} data-pagefind-ignore="all">
      <ReleaseNotes markdown={maintenance} />
    </div>
  )
}
