---
import Item from "./Item.astro";

type Sections = {
  title: string;
  items: item[];
}[];

type item = {
  title: string;
  slug: string;
  maintenance?: boolean;
};

const {
  sections,
  baseUrl,
  current = Astro.url.pathname.replace(/\/$/, ""),
}: { sections: Sections; baseUrl: string; current?: string } = Astro.props;
---

<ul>
  {
    sections.map((section) => (
      <li class="mb-6">
        <h5 class="mb-2 text-xs font-semibold uppercase tracking-wide text-stone-500">
          {section.title}
        </h5>
        <ul class="border-l border-solid border-stone-300">
          {section.items.map((item) => (
            <Item
              title={item.title}
              baseUrl={baseUrl}
              slug={item.slug}
              current={current}
              maintenance={item.maintenance}
            />
          ))}
        </ul>
      </li>
    ))
  }
</ul>
