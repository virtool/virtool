---
const { title, baseUrl, slug, current } = Astro.props;
const href = baseUrl ? `${baseUrl}/${slug}` : `${slug}`;
---

<li>
  <a
    class="-ml-px block border-l-2 border-transparent py-1 pl-3 text-sm text-stone-600 hover:text-stone-900 [&[aria-current]]:border-sky-700 [&[aria-current]]:text-sky-700"
    href={href}
    rel="prefetch"
    aria-current={href === current ? "page" : undefined}
  >
    {title}
  </a>
</li>
