---
import { formatDate } from "@utils/date";

const { post, releaseHref } = Astro.props;
---

<p class="text-stone-600">
  <span class="capitalize">{post.type}</span>{" · "}
  {
    post.type === "release" && post.version && (
      <>
        {releaseHref ? <a href={releaseHref}>{post.version}</a> : post.version}
        {" · "}
      </>
    )
  }
  {
    post.date ? (
      <time datetime={post.date}>{formatDate(post.date)}</time>
    ) : (
      "Unreleased"
    )
  }
</p>
