{
  "name": "@virtool/site",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist --glob 'docs/**/*.html' --output-subdir docs/pagefind && pagefind --site dist --glob 'changelog/**/*.html' --output-subdir changelog/pagefind",
    "preview": "pnpm run build && wrangler dev",
    "preview:astro": "astro preview",
    "deploy": "pnpm run build && wrangler deploy",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/prism": "^4.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.66.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@virtool/changelog": "workspace:*",
    "astro": "^7.4.4",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "node-cache": "^5.1.2",
    "prismjs": "^1.30.0",
    "satteri": "^0.11.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
