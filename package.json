{
	"name": "virtool-ui",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"build": "pnpm -r --filter \"./apps/*\" --filter \"!@virtool/site\" build",
		"check": "biome check --error-on-warnings apps packages scripts",
		"develop": "pnpm --filter @virtool/web develop",
		"docs:lint": "vale sync && git ls-files -z '*.md' '*.mdx' | xargs -0 vale",
		"format": "biome check --write apps packages scripts",
		"knip": "knip",
		"test": "pnpm -r test",
		"typecheck": "pnpm -r typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/node": "^26.6.6",
		"knip": "^6.44.1",
		"typescript": "^7.0.2"
	}
}
