{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreExportsUsedInFile": true,
	"ignoreDependencies": ["@virtool/tsconfig"],
	"ignoreWorkspaces": [
		"apps/site"
	],
	"ignore": [
		".venv/**"
	],
	"workspaces": {
		"apps/create-sample": {
			"ignoreDependencies": ["@virtool/image-build", "@virtool/quality-core", "@virtool/workflow-tools"]
		},
		"apps/create-subtraction": {
			"ignoreDependencies": ["@virtool/image-build", "@virtool/workflow-tools"]
		},
		"apps/internal": {
			"ignoreDependencies": ["@virtool/image-build"]
		},
		"apps/nuvs": {
			"ignoreDependencies": ["@virtool/image-build", "@virtool/workflow-tools"]
		},
		"apps/pathoscope": {
			"ignoreDependencies": ["@virtool/image-build", "@virtool/pathoscope-core", "@virtool/workflow-tools"]
		},
		"apps/web": {
			"entry": [
				"src/instrument.server.ts",
				"src/routes/**/*.{ts,tsx}",
				"src/types/window.ts",
				"src/tests/postgresGuard.ts"
			],
			"project": [
				"src/**/*.{ts,tsx,css}"
			],
			"ignoreDependencies": ["@virtool/image-build", "bcrypt"]
		},
		"packages/bio": {
			"entry": [
				"src/**/*.test.ts"
			]
		},
		"packages/contracts": {
			"entry": [
				"src/**/*.test.ts"
			]
		},
		"packages/data": {
			"entry": [
				"src/**/*.test.ts"
			]
		},
		"packages/storage": {
			"entry": [
				"src/**/*.test.ts"
			]
		},
		"packages/logger": {
			"entry": [
				"src/**/*.test.ts"
			]
		},
		"packages/sentry": {
			"entry": [
				"src/**/*.test.ts"
			]
		},
		"packages/service": {
			"entry": [
				"src/**/*.test.ts"
			]
		},
		"packages/archive": {
			"entry": [
				"src/**/*.test.ts"
			]
		},
		"packages/sqlite": {
			"entry": [
				"src/**/*.test.ts"
			]
		},
		"packages/workflow": {
			"entry": [
				"src/**/*.test.ts"
			]
		},
		"packages/ncbi": {
			"entry": [
				"src/**/*.test.ts",
				"scripts/*.ts"
			]
		}
	}
}
